# Copy this file to .env and fill in your own values.
# .env is gitignored — never commit it, and never upload it via GitHub's
# drag-and-drop file uploader, which ignores .gitignore.

# Supabase (Project Settings -> API in your Supabase dashboard).
# The VITE_ prefix publishes these to the browser — that is intended here.
VITE_SUPABASE_URL=https://YOUR-PROJECT-ID.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-public-key

# Anthropic, for AI marking (console.anthropic.com).
# NO VITE_ PREFIX — this must stay server-side. Only needed locally if you run
# `npx vercel dev`; in production set it in the Vercel dashboard instead.
ANTHROPIC_API_KEY=sk-ant-your-key-here
